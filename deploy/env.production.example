# Production environment for /var/www/ainews/.env
# Never commit the filled version. chmod 600 and chown root:www-data.

FLASK_APP=app/app.py
FLASK_ENV=production

SECRET_KEY=replace-with-a-long-random-string
# Absolute SQLite path (four slashes = absolute path).
DATABASE_URL=sqlite:////var/www/ainews/data/ainews.db

# The magazine lives at https://nasserdiary.com/ainews/
APPLICATION_ROOT=/ainews
SESSION_COOKIE_PATH=/ainews

ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_PASSWORD_HASH=

OPENAI_API_KEY=
GOOGLE_API_KEY=
SEARCH_ENGINE_ID=
YOUTUBE_API_KEY=
